# {{ ansible_managed }}
# NIST AU-4 audit storage capacity, AU-5 response to failures, AU-9 protection,
# AU-11 retention.
local_events = yes
write_logs = yes
log_file = {{ auditd_log_file }}
log_group = root
log_format = {{ auditd_log_format }}
flush = {{ auditd_flush }}
freq = {{ auditd_freq }}
max_log_file = {{ auditd_max_log_file_mb }}
num_logs = {{ auditd_num_logs }}
priority_boost = 4
name_format = {{ auditd_name_format }}
max_log_file_action = {{ auditd_max_log_file_action }}
space_left = {{ auditd_space_left_mb }}
space_left_action = {{ auditd_space_left_action }}
verify_email = yes
action_mail_acct = {{ auditd_action_mail_acct }}
admin_space_left = {{ auditd_admin_space_left_mb }}
admin_space_left_action = {{ auditd_admin_space_left_action }}
disk_full_action = {{ auditd_disk_full_action }}
disk_error_action = {{ auditd_disk_error_action }}
use_libwrap = yes
tcp_listen_queue = 5
tcp_max_per_addr = 1
tcp_client_max_idle = 0
transport = tcp
krb5_principal = auditd
distribute_network = no
q_depth = 2000
overflow_action = SYSLOG
max_restarts = 10
plugin_dir = {{ auditd_plugins_dir }}
end_of_event_timeout = 2
