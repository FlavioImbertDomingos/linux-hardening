#!/usr/sbin/nft -f
# {{ ansible_managed }} — NIST SC-7 boundary protection, CM-7 least functionality
flush ruleset

table inet filter {
{% if firewall_admin_cidrs | length > 0 %}
    set admin_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ firewall_admin_cidrs | select('match', '^[0-9.]+(/[0-9]+)?$') | join(', ') }} }
    }
{% endif %}
{% if firewall_monitoring_cidrs | length > 0 %}
    set monitoring_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ firewall_monitoring_cidrs | select('match', '^[0-9.]+(/[0-9]+)?$') | join(', ') }} }
    }
{% endif %}

    chain input {
        type filter hook input priority 0; policy drop;

        iif "lo" accept
        ct state established,related accept
        ct state invalid drop

        # ICMP: needed for PMTUD / neighbour discovery; echo is rate-limited
        ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
        ip protocol icmp icmp type echo-request limit rate {{ firewall_icmp_ratelimit }} accept
        ip6 nexthdr icmpv6 icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept
        ip6 nexthdr icmpv6 icmpv6 type echo-request limit rate {{ firewall_icmp_ratelimit }} accept

        # SSH (AC-17)
{% if firewall_allow_build_controller | bool and firewall_build_controller_ip is match('^[0-9.]+$') %}
        # build-time only: host running Ansible (removed by the finalize play)
        ip saddr {{ firewall_build_controller_ip }} tcp dport {{ firewall_ssh_port }} accept
{% endif %}
{% if firewall_admin_cidrs | length > 0 %}
        ip saddr @admin_v4 tcp dport {{ firewall_ssh_port }} ct state new limit rate 15/minute accept
{% else %}
        tcp dport {{ firewall_ssh_port }} ct state new limit rate 15/minute accept
{% endif %}

        # node_exporter scrapes (SI-4)
{% if firewall_expose_node_exporter | bool and firewall_monitoring_cidrs | length > 0 %}
        ip saddr @monitoring_v4 tcp dport {{ firewall_node_exporter_port }} accept
{% endif %}

{% for r in firewall_extra_rules %}
{% if r.cidrs is defined and r.cidrs | length > 0 %}
        ip saddr { {{ r.cidrs | join(', ') }} } {{ r.proto | default('tcp') }} dport {{ r.port }} accept
{% else %}
        {{ r.proto | default('tcp') }} dport {{ r.port }} accept
{% endif %}
{% endfor %}

{% if firewall_log_dropped | bool %}
        limit rate {{ firewall_log_rate }} log prefix "nft-drop-in: " level info
{% endif %}
        drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
