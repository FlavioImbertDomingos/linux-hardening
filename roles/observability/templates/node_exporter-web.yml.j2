# {{ ansible_managed }} — TLS for node_exporter when exposed on the network (SC-8)
tls_server_config:
  cert_file: {{ observability_node_exporter_tls_cert }}
  key_file: {{ observability_node_exporter_tls_key }}
  min_version: TLS12
  cipher_suites:
    - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
    - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
    - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
    - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305
